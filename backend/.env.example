DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# sqlite (default) or postgres
DB_ENGINE=sqlite
POSTGRES_DB=biocareplus
POSTGRES_USER=biocare
POSTGRES_PASSWORD=biocare
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# WhatsApp : console (aucun envoi, affichage dans la console) | twilio | meta
WHATSAPP_PROVIDER=console
WHATSAPP_DEFAULT_COUNTRY_CODE=228
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
PATIENT_PORTAL_URL=http://localhost:5173/app
APPOINTMENT_REMINDER_HOURS=24

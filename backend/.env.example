DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# sqlite (default) or postgres
DB_ENGINE=sqlite
# Optional absolute path for SQLite; defaults to backend/db.sqlite3
# SQLITE_DB_PATH=C:\path\to\biocareplus-demo.sqlite3
POSTGRES_DB=biocareplus
POSTGRES_USER=biocare
POSTGRES_PASSWORD=biocare
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
